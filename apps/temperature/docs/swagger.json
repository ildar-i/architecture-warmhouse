    "host": "127.0.0.1:8081",
    "basePath": "/",
    "paths": {
        "/temperature/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "summary": "получить температуру по идентификатору сенсора",
                "parameters": [
                    {
                        "type": "string",
                        "description": "идентификатор сенсора",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/common.TemperatureResponse"
                        }
                    }
                }
            }
        },
        "/temperatures": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "summary": "получить температуру по идентификатору сенсора",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/common.SensorTemperatureList"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "common.SensorTemperatureList": {
            "type": "object",
            "properties": {
                "temperaturesResponse": {
                    "type": "array",
                    "items": {

@startuml
title Device Service ER Diagram

class House {
    +Integer house_id
    +String user_id
    +void turnOfAllDevices()
}

class Device {
    +Integer device_id
    +String name
    +String status
    +String serial_number
    +Integer device_type_id_fk
    +void turnOfDevice()
    +void turnOnDevice()
}

class DeviceType {
    +Integer device_type_id
    +String name
}

House "1" -- "0..*" Device : has
Device "1" -- "0..*" DeviceType : has

@enduml